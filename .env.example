# Copy this file to .env.local and fill in the blanks.
# With no .env.local at all, Dzine runs in demo mode: no sign-in, in-memory data, sample designer.

# --- Supabase (auth, database, file storage). These two are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://ygbzkjafoklhoblwiorc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ut_GTR5SKLBTFVev-grLyg_hwIs_cgI
# Secret. Supabase dashboard > Project Settings > API keys > service_role (or a new secret key).
SUPABASE_SERVICE_ROLE_KEY=

# --- The designer (Claude). https://platform.claude.com > API keys
ANTHROPIC_API_KEY=

# --- AI imagery and background removal. https://fal.ai/dashboard/keys
FAL_KEY=

# --- Free, fully local alternative (Apple Silicon Mac, not Vercel). See README "Run locally for free".
# ANTHROPIC_BASE_URL=http://localhost:11434   # Ollama stands in for Claude
# ANTHROPIC_API_KEY=ollama
# DZINE_AGENT_MODEL=gemma4:26b
# DZINE_THINKING=off
# DZINE_TEMPLATE_MODE=1                      # designer picks a type treatment, code places every box
# DZINE_LOCAL_IMAGES=1                       # images via mflux instead of fal
# DZINE_LOCAL_IMAGE_SIZE=1536                # long side in px
# DZINE_MFLUX_DIR=~/.local/bin

# --- Payments. Leave either provider blank to hide it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# --- Public address of the app, no trailing slash. Used for payment and sign-in redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional tuning
# DZINE_AGENT_MODEL=claude-opus-5-5        # claude-sonnet-5-5 is about half the price
# DZINE_IMAGE_MODEL=fal-ai/nano-banana-pro
# DZINE_IMAGE_RESOLUTION=2K                # 1K, 2K or 4K
# DZINE_MAX_IMAGES_PER_TURN=3
# DZINE_REVIEW_PASSES=1                    # 0 turns off the self-review pass
# DZINE_THINKING=off
